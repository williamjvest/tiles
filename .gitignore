# Camera makers' SDKs and documents: licensed to us, not ours to share. Kept local.
vendor/sony/
vendor/blackmagic/

.DS_Store
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# Generated by XcodeGen from App/project.yml
App/*.xcodeproj/
App/CameraControl/Info.plist
.build-*/

# Node dependencies and build artifacts
integrations/streamdeck/node_modules/
integrations/streamdeck/dist/
integrations/streamdeck/com.toldwell.twcc.sdPlugin/bin/
integrations/companion-module/node_modules/
integrations/companion-module/dist/

# Packaged builds (npx streamdeck pack, npm run package): made from the sources, handed out, not committed
*.streamDeckPlugin
integrations/companion-module/*.tgz

# Simulator QA screenshot output
qa-out/

# Camera capture sessions (scripts/venice): raw traffic from cameras, sometimes not ours. Promote reviewed bits to fixtures/.
captures/

# Python bytecode
__pycache__/
*.pyc
!site/downloads/*.streamDeckPlugin
